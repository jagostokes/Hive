# Copy to .env and fill in. Do not commit .env.

# --- OpenRouter (all model calls go through here) ---
# OpenAI SDK with baseURL https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# --- APP Postgres (Hive's own brain-state tables) ---
# Holds query_cache (pgvector), business_glossary, prompt_versions,
# learned_examples, synthesized_verifiers, training_runs/metrics.
# Neon (free): https://console.neon.tech — pgvector enabled by default.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- DATA Postgres (the analytics dataset the questions run against) ---
# Optional. When set, Hive introspects + queries THIS database for analytics
# (e.g. Northwind), while keeping its own brain state in DATABASE_URL above.
# When unset, it falls back to DATABASE_URL (single-database setup).
# Example: ClickHouse Cloud's PostgreSQL endpoint.
DATA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
