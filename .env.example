# Copy to .env and fill in. Do not commit .env.

# --- OpenRouter (all model calls go through here) ---
# OpenAI SDK with baseURL https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# --- InsForge Postgres (data source) ---
# Full connection string used for runtime schema discovery + queries.
# Get it with: npx @insforge/cli db connection-string
DATABASE_URL=postgresql://postgres:PASSWORD@bxxs7u3i.us-east.database.insforge.app:5432/insforge?sslmode=require

# --- InsForge project (optional: SDK / CLI access) ---
INSFORGE_URL=https://bxxs7u3i.us-east.insforge.app
# npx @insforge/cli secrets get ANON_KEY
INSFORGE_ANON_KEY=
# Admin/service key for privileged server-side access
INSFORGE_API_KEY=
