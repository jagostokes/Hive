# Copy to .env and fill in. Do not commit .env.

# --- OpenRouter (all model calls go through here) ---
# OpenAI SDK with baseURL https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# --- Postgres (data source) ---
# Full connection string. Neon (free): https://console.neon.tech
# Create a project, copy the connection string, paste here.
# pgvector is enabled by default on Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
