{
  "name": "hive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Brain-pattern data-question system: decompose into verified sub-agents on cheap models, escalate on verified failure, compared against a single strong-model baseline.",
  "scripts": {
    "dev": "echo \"[hive] dev placeholder — orchestrator not implemented yet\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:setup": "npx -y @insforge/cli db import src/db/schema.sql",
    "demo:context": "tsx scripts/contextDemo.ts",
    "smoke:model": "tsx scripts/modelSmoke.ts",
    "test:verifiers": "tsx scripts/verifiersTest.ts",
    "test:sql-agent": "tsx scripts/sqlAgentTest.ts",
    "test:agents": "tsx scripts/agentsTest.ts",
    "test:planner-cache": "tsx scripts/plannerCacheTest.ts",
    "test:orchestrator": "tsx scripts/orchestratorTest.ts",
    "test:comparison": "tsx scripts/comparisonTest.ts",
    "test:cache-reuse": "tsx scripts/cacheReuseTest.ts",
    "seed:glossary": "tsx scripts/seedGlossary.ts",
    "seed:cache": "tsx scripts/seedCache.ts",
    "compare": "tsx scripts/compare.ts",
    "ui:server": "tsx src/server/index.ts",
    "ui:dev": "cd ui && npm install && npm run dev",
    "ui": "concurrently -k -n api,web -c yellow,magenta \"npm run ui:server\" \"npm run ui:dev\""
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "dotenv": "^16.4.5",
    "hono": "^4.6.14",
    "openai": "^4.67.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
